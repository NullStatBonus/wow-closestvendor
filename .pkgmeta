package-as: ClosestVendor

# The addon lives in ClosestVendor/ inside the repository; move it to the top of the package.
move-folders:
  ClosestVendor/ClosestVendor: ClosestVendor

# AceGUI, AceConfigRegistry/Dialog, CallbackHandler and LibStub are vendored in Libs.
# Their upstream license and provenance ship with the addon; no release-time fetch is needed.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .claude
  - .github
  - CLAUDE.md
  - AGENTS.md
  - CONTRIBUTING.md
  - Makefile
  - README.md
  - docs
  - openspec
  - tests
  - tools
